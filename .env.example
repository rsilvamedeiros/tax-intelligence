# Apenas desenvolvimento local; copie para .env na raiz (API carrega esse arquivo).
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
API_BASE_URL=http://127.0.0.1:3001
# Opcional no bootstrap; obrigatória em produção. Não usar credenciais reais.
# DATABASE_URL=postgresql://tax_local:local_only_change_me@127.0.0.1:5432/tax_intelligence
# TEST_DATABASE_URL=postgresql://tax_local:local_only_change_me@127.0.0.1:5432/tax_intelligence_test
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Opcional: configurar todas as quatro para habilitar verificação de access token.
# OIDC_ISSUER=http://127.0.0.1:8080/realms/tax-intelligence
# OIDC_JWKS_URL=http://127.0.0.1:8080/realms/tax-intelligence/protocol/openid-connect/certs
# OIDC_AUDIENCE=tax-intelligence-api
# OIDC_CLIENT_ID=tax-intelligence-web
