{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "API_BASE_URL",
        "NODE_ENV",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
        "CORS_ORIGIN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["TEST_DATABASE_URL"]
    },
    "dev": {
      "env": [
        "OIDC_ISSUER",
        "OIDC_JWKS_URL",
        "OIDC_AUDIENCE",
        "OIDC_CLIENT_ID",
        "BFF_APP_ORIGIN",
        "BFF_DATABASE_URL",
        "BFF_SESSION_ENCRYPTION_KEY",
        "API_BASE_URL"
      ],
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
